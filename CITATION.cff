  - family-names: Farid
    given-names: Mazen
license: MIT
repository-code: "https://github.com/EngHatem97/mdrg-bcic2020iv"
keywords:
  - EEG
  - imagined speech
  - brain-computer interface
  - Riemannian geometry
  - evaluation protocol
